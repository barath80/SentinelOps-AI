# Copy to .env for local runs (pydantic-settings reads it). Never commit real values.

# Postgres for anything shared; defaults to a local SQLite file.
SENTINEL_DATABASE_URL=
# Machine token: the shop's telemetry push and automation (ingest, read, analysis). Empty = rejects everything.
SENTINEL_INGEST_TOKEN=

# People sign in ("operators", default). "shared_token" is legacy: anyone with the token can claim any name.
SENTINEL_AUTH_MODE=operators
# Required (true) for shared_token mode; refused on hosted deployments.
SENTINEL_ALLOW_INSECURE_SHARED_TOKEN=false
# Signs sessions: 32+ random characters (openssl rand -hex 32). Empty = nobody can sign in.
SENTINEL_SESSION_SECRET=
SENTINEL_SESSION_TTL_SECONDS=28800
# First admin, "username:password" (12+ characters). Used only while no operator exists.
SENTINEL_BOOTSTRAP_ADMIN=

# Recovery actions: "mock" records only; "shop_admin" drives the demo shop's fault toggle.
SENTINEL_EXECUTOR=mock
SENTINEL_SHOP_ADMIN_URL=
SENTINEL_SHOP_ADMIN_TOKEN=

# Background upkeep (0 = off). Not on serverless hosts.
SENTINEL_ANALYZE_INTERVAL_SECONDS=0
SENTINEL_AUTO_INVESTIGATE=false
SENTINEL_RETENTION_DAYS=7

# Links in notifications point here (e.g. https://sentinel.example).
SENTINEL_PUBLIC_URL=
# The monitored application; the dashboard sidebar links to it (e.g. https://shop.example).
SENTINEL_SHOP_URL=
# Local tests only: allow webhooks to private addresses and http.
SENTINEL_NOTIFY_ALLOW_PRIVATE=false
# Automatic remediation: false makes it impossible to switch on; cap on actions per hour.
SENTINEL_AUTOMATION_ALLOWED=true
SENTINEL_AUTOMATION_MAX_ACTIONS_PER_HOUR=3
# Request-rate limits per minute: per credential, sign-in per address, telemetry ingest.
SENTINEL_RATE_LIMIT_PER_MINUTE=600
# Reverse proxies in front of the API (Render: 1). Their X-Forwarded-For entry gives the client address.
SENTINEL_TRUSTED_PROXY_HOPS=0
SENTINEL_LOGIN_RATE_LIMIT_PER_MINUTE=30
SENTINEL_INGEST_RATE_LIMIT_PER_MINUTE=6000
