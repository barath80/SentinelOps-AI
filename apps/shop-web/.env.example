# Neon Postgres connection string (pooled). Required for orders.
DATABASE_URL=
# Canonical site URL (no trailing slash). Used for OAuth redirect URIs and SEO
# (canonical links, sitemap, JSON-LD). Falls back to http://localhost:3000 in dev.
APP_URL=
# Copy to .env.local for local runs. Never commit real values.

# Session signing (JWT). Required, 32+ characters, or sign-in is disabled (fail closed).
AUTH_SECRET=
# Optional: enables "Continue with Google". Register the redirect URI
# {APP_URL}/api/auth/google/callback in Google Cloud Console.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Transactional email (password reset). "console" (default) logs the message instead of
# sending it, so dev/test never needs a real provider. Set to "resend" + RESEND_API_KEY to send.
EMAIL_PROVIDER=console
RESEND_API_KEY=

# Where to push structured events (leave empty to disable pushing).
SENTINEL_INGEST_URL=
SENTINEL_INGEST_TOKEN=
# Demo fault injection: none | S01_bad_deployment | S03_slow_query | S05_payment_timeout
FAULT_SCENARIO=none
# Required to call /api/admin/fault. Unset = admin endpoint rejects everything.
ADMIN_TOKEN=
