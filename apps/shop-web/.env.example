# Neon Postgres connection string (pooled). Required for orders.
DATABASE_URL=
# Copy to .env.local for local runs. Never commit real values.
# Where to push structured events (leave empty to disable pushing).
SENTINEL_INGEST_URL=
SENTINEL_INGEST_TOKEN=
# Demo fault injection (every request): none | S01_bad_deployment | S03_slow_query | S05_payment_timeout | S08_plain_errors
FAULT_SCENARIO=none
# Required to call /api/admin/fault. Unset = admin endpoint rejects everything.
ADMIN_TOKEN=
# Scoped chaos: requests with x-chaos-token = CHAOS_TOKEN and x-chaos-scenario get that fault (16+ chars; unset = off).
CHAOS_TOKEN=
